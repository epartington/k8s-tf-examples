# ---------------------------------------------------------------------------
# Shared inputs for the POV GKE + PRISMA AIRS / Portkey AI Gateway stages.
#
# Copy to terraform.tfvars and pass into each stage with:
#   terraform apply -var-file=../terraform.tfvars
# (See README.md for the full apply loop.)
#
# Not every stage consumes every variable; unused vars are simply ignored per
# stage. Nothing sensitive lives here — Portkey/registry credentials are supplied
# via the console-downloaded values.yaml (see the 40-portkey section).
# ---------------------------------------------------------------------------

# --- Core (all stages) ---
project_id = "my-pov-project"
region     = "us-central1"

# GCS bucket for remote state. Must be globally unique. Created by 00-bootstrap
# and passed to every other stage via: terraform init -backend-config="bucket=..."
state_bucket = "my-pov-project-airs-gw-tfstate"

# --- 10-network ---
subnet_cidr = "10.10.0.0/20"
# Leave pods_cidr / services_cidr empty to let GKE auto-allocate Google-managed
# secondary ranges (the "pre-allocated Google ranges" path). Set both to pin them.
# pods_cidr     = "10.20.0.0/16"
# services_cidr = "10.30.0.0/20"
master_ipv4_cidr = "172.16.0.0/28"

# --- 20-gke ---
node_count   = 2
machine_type = "n1-standard-4" # 4 vCPU / 16 GB
# machine_type = "e2-standard-4" # cheaper GKE-native alternative (4 vCPU / 16 GB)
release_channel = "REGULAR"

# CIDRs allowed to reach the public control-plane endpoint (kubectl/helm from
# your operator or CI egress IP). Required so stages 40/50 can apply.
authorized_networks = ["203.0.113.10/32"]

# --- 30-iam ---
# Defaults to project_id when empty. Set for cross-project Vertex access.
model_project_id = ""

# --- 30-iam / 40-portkey (must match across both) ---
namespace = "airs-gw"
ksa_name  = "gateway-sa"

# --- 40-portkey ---
# Credentials come from the values.yaml downloaded from the AI Gateway console.
# Save it as GKE/terraform/40-portkey/values.yaml (see values.yaml.example) — the
# values_file variable defaults to that path, so no config is needed here.
# Override only if you keep it elsewhere:
# values_file = "/abs/path/to/values.yaml"
#
# The chart is pulled from the official airs-gw Helm repo:
#   https://portkey-ai.github.io/airs-gw-helm
# Leave chart_version empty for the latest published chart, or pin for reproducibility.
# chart_version = "1.2.0"
#
# Image repo/tag come from the console values.yaml / chart. Override only to swap
# registries or hotfix a tag:
# image_repository = "docker.io/portkeyai/gateway_enterprise"
# image_tag        = "2.21.0"
image_repository = ""
image_tag        = ""
#
# MCP: server_mode "all" runs both the gateway (8787) and the MCP server (8788)
# in one pod, and stage 50 fronts BOTH through the same HTTPS LB + Cloud Armor.
# Set "mcp" for MCP-only, or "" for gateway-only (MCP not exposed).
# server_mode = "all"
# mcp_port    = 8788

# --- 50-ingress ---
# Cloud Armor allowlist for callers of the gateway. Everything else gets 403.
allowed_source_ranges = ["203.0.113.0/24"]

# FQDN for the managed TLS cert. Leave empty to derive "<static-ip>.nip.io".
domain = ""

# MCP endpoint hostname (added as a SAN on the same cert, routed to port 8788
# through the same LB + Cloud Armor). Leave empty to derive "mcp.<gateway-domain>";
# with the nip.io fallback "mcp.<ip>.nip.io" resolves to the same LB IP for free.
# Only used when the gateway runs with MCP enabled (server_mode "all"/"mcp").
mcp_domain = ""

# IAP stays off for the POV (it would block plain API calls). Cloud Armor is the
# primary control. To enable, set true and provide iap_support_email.
iap_enabled = false
# iap_support_email = "security@example.com"
