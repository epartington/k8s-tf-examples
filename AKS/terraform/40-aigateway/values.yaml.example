# ---------------------------------------------------------------------------
# airs-gw values — DOWNLOADED FROM THE AI GATEWAY CONSOLE
#
# HOW TO USE
#   1. In the AI Gateway (Portkey) console, generate/download the hybrid
#      deployment values.yaml for this data plane.
#   2. Save it in THIS directory as:  values.yaml
#      (i.e. AKS/terraform/40-aigateway/values.yaml)
#      The `values_file` variable already defaults to that path, so stage 40
#      picks it up automatically — no extra config needed.
#   3. Apply stage 40.
#
# The real values.yaml carries credentials and is gitignored — never commit it.
# This .example file is only a reference for the shape of that download.
#
# DO NOT hand-set the Azure-specific bits below — Terraform overlays them on top
# of this file at apply time, and its overlay wins:
#   - serviceAccount.annotations."azure.workload.identity/client-id"  (Workload Identity)
#   - podLabels."azure.workload.identity/use" = "true"                (WI webhook)
#   - environment.data.SERVER_MODE / MCP_PORT                         (gateway/MCP mode)
#   - service.type                                                    (ClusterIP for AGIC)
#   - ingress.enabled = false                                         (ingress is stage 50)
# ---------------------------------------------------------------------------

# Registry pull credentials for the enterprise gateway image (from the console).
imageCredentials:
  - name: airsgatewayregistrycredentials
    create: true
    registry: https://registry.portkey.ai
    username: "<from-console>"
    password: "<from-console>"

# Hybrid control-plane credentials (from the console).
environment:
  create: true
  secret: true
  data:
    PORTKEY_CLIENT_AUTH: "<from-console>"
    ORGANISATIONS_TO_SYNC: "<from-console>"
    # LOG_STORE / ANALYTICS_STORE etc. reflect your console configuration.
    #
    # Azure OpenAI auth fallback (see the 40-aigateway README "Model auth" note):
    # if the gateway build cannot mint an Entra token for Azure OpenAI via
    # Workload Identity, provide the model API key here instead and configure the
    # Azure OpenAI provider in the Portkey console with that key.
    # AZURE_OPENAI_API_KEY: "<from-key-vault-or-console>"

# Bundled Redis stays on for the POV; data service / MinIO / Milvus off.
# (These usually come preset in the console download; shown here for reference.)
dataservice:
  enabled: false
minio:
  enabled: false
milvus:
  enabled: false
